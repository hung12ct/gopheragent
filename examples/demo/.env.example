# ── LLM Provider ────────────────────────────────────────────────────────────
# Pick one: openai | anthropic | gemini
# Leave blank to run with MockProvider (no API calls).
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ── Tools ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Agent YAML (optional, defaults to ../yaml_agents/web_research_chat.yaml)
# AGENT_YAML_PATH=../yaml_agents/content_writer.yaml

# ── Session Persistence (optional) ───────────────────────────────────────────
# Without these, sessions are in-memory only (lost on restart).
#
# Option 1: MySQL (survives restarts, multi-instance safe)
# MYSQL_DSN=user:pass@tcp(localhost:3306)/gopheragent?parseTime=true
#
# Option 2: File (survives restarts, no DB required)
# SESSION_DIR=./sessions
